{
  "name": "sveltekit-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "seed": "bun run src/lib/server/db/seed.ts",
    "test": "vitest run --passWithNoTests --exclude test-api.test.ts",
    "test:integration": "vitest run test-api.test.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.60.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "svelte": "^5.55.7",
    "svelte-check": "^4.1.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@tablecraft/engine": "workspace:*",
    "@tablecraft/adapter-sveltekit": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "dotenv": "^17.4.2"
  }
}
